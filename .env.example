# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Single-College Foundly)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase service role key (KEEP SECRET — never prefix with VITE_)
# Used for admin Excel exports, role assignments, and email idempotency checks.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the configured single college UUID (defaults to public.app_config id=1)
SINGLE_COLLEGE_ID=

# Resend Email Configuration (Server-side only)
RESEND_API_KEY=
FROM_EMAIL=

# Optional server-side College Admin Login credentials override (never prefix with VITE_)
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
